    {
      "name": "💳 4 — PAIEMENT CHACHAP PAY",
      "item": [

        {
          "name": "4.1 Initier paiement ChaChap (acheteur) → payment_url",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('chachap = true', () => pm.expect(b.chachap).to.be.true);",
            "pm.test('payment_url présent', () => pm.expect(b.payment_url).to.be.a('string'));",
            "pm.test('payment_url est chapchappay.com', () => pm.expect(b.payment_url).to.include('chapchappay.com'));",
            "pm.collectionVariables.set('payment_url', b.payment_url);",
            "console.log('✅ payment_url =', b.payment_url);",
            "console.log('📌 Référence =', b.payment?.external_ref);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"provider\": \"chachap\"\n}" },
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/pay/", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "pay", ""] }
          }
        },

        {
          "name": "4.2 Paiement espèces (cash) — test alternatif",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('provider = cash', () => pm.expect(b.payment?.provider || b.provider || '').to.include('cash'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{buyer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"provider\": \"cash\"\n}" },
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/pay/", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", "pay", ""] }
          }
        },

        {
          "name": "4.3 Simuler webhook ChaChap (confirmation paiement)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "console.log('Réponse webhook:', pm.response.json());"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "CCP-Signature", "value": "test-signature-simulation" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"order_id\": \"{{order_id}}\",\n  \"operation_id\": \"SIM-CCP-ABCD1234\",\n  \"status\": \"success\",\n  \"amount\": 4500000,\n  \"currency\": \"GNF\"\n}" },
            "url": { "raw": "{{base_url}}/orders/webhook/chachap/", "host": ["{{base_url}}"], "path": ["orders", "webhook", "chachap", ""] }
          }
        },

        {
          "name": "4.4 Vérifier commande après paiement (status = paid ?)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "console.log('Order status après paiement:', b.status);",
            "console.log('Payments:', JSON.stringify(b.payments));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{buyer_token}}" }],
            "url": { "raw": "{{base_url}}/orders/{{order_id}}/", "host": ["{{base_url}}"], "path": ["orders", "{{order_id}}", ""] }
          }
        }

      ]
    },

