{
  "info": {
    "name": "Guimatrix — Tests complets",
    "_postman_id": "guimatrix-full-test-suite",
    "description": "Test complet : inscription, connexion, annonce, commande, paiement ChaChap, livraison, retour, mot de passe oublié.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",        "value": "https://api.guimatrix.com/api/v1" },
    { "key": "seller_token",    "value": "" },
    { "key": "buyer_token",     "value": "" },
    { "key": "seller_phone",    "value": "+224620000001" },
    { "key": "buyer_phone",     "value": "+224620000002" },
    { "key": "listing_id",      "value": "" },
    { "key": "order_id",        "value": "" },
    { "key": "payment_url",     "value": "" }
  ],
  "item": [

    {
      "name": "🔐 1 — AUTHENTIFICATION",
      "item": [

        {
          "name": "1.1 Inscription vendeur",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "pm.test('Message OTP envoyé', () => {",
            "  const b = pm.response.json();",
            "  pm.expect(b.message || b.detail || JSON.stringify(b)).to.include.oneOf(['envoyé','created','OTP','vérification']);",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Test Vendeur\",\n  \"phone_number\": \"{{seller_phone}}\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"seller\",\n  \"city\": \"Conakry\",\n  \"quartier\": \"Kaloum\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/register/", "host": ["{{base_url}}"], "path": ["accounts", "register", ""] }
          }
        },

        {
          "name": "1.2 Inscription acheteur",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Test Acheteur\",\n  \"phone_number\": \"{{buyer_phone}}\",\n  \"password\": \"TestPass123!\",\n  \"role\": \"buyer\",\n  \"city\": \"Conakry\",\n  \"quartier\": \"Dixinn\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/register/", "host": ["{{base_url}}"], "path": ["accounts", "register", ""] }
          }
        },

        {
          "name": "1.3 Vérifier OTP vendeur",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{seller_phone}}\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/verify-otp/", "host": ["{{base_url}}"], "path": ["accounts", "verify-otp", ""] }
          }
        },

        {
          "name": "1.4 Vérifier OTP acheteur",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{buyer_phone}}\",\n  \"code\": \"123456\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/verify-otp/", "host": ["{{base_url}}"], "path": ["accounts", "verify-otp", ""] }
          }
        },

        {
          "name": "1.5 Connexion vendeur → seller_token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('access token présent', () => pm.expect(b.access).to.be.a('string'));",
            "pm.collectionVariables.set('seller_token', b.access);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{seller_phone}}\",\n  \"password\": \"TestPass123!\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/login/", "host": ["{{base_url}}"], "path": ["accounts", "login", ""] }
          }
        },

        {
          "name": "1.6 Connexion acheteur → buyer_token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('access token présent', () => pm.expect(b.access).to.be.a('string'));",
            "pm.collectionVariables.set('buyer_token', b.access);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"{{buyer_phone}}\",\n  \"password\": \"TestPass123!\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/login/", "host": ["{{base_url}}"], "path": ["accounts", "login", ""] }
          }
        },

        {
          "name": "1.7 Profil vendeur (GET /me/)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('role = seller', () => pm.expect(b.role).to.equal('seller'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }],
            "url": { "raw": "{{base_url}}/accounts/me/", "host": ["{{base_url}}"], "path": ["accounts", "me", ""] }
          }
        },

        {
          "name": "1.8 Connexion email invalide → message d'erreur clair",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 400', () => pm.response.to.have.status(400));",
            "const b = pm.response.json();",
            "pm.test('Message erreur lisible', () => {",
            "  const msg = JSON.stringify(b);",
            "  pm.expect(msg).to.satisfy(m => m.includes('compte') || m.includes('Aucun') || m.includes('incorrect'));",
            "});"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone_number\": \"+224699999999\",\n  \"password\": \"WrongPass!\"\n}" },
            "url": { "raw": "{{base_url}}/accounts/login/", "host": ["{{base_url}}"], "path": ["accounts", "login", ""] }
          }
        }

      ]
    },

    {
      "name": "📦 2 — ANNONCES (LISTINGS)",
      "item": [

        {
          "name": "2.1 Créer annonce (vendeur) → listing_id",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('id présent', () => pm.expect(b.id).to.be.a('string'));",
            "pm.collectionVariables.set('listing_id', b.id);",
            "console.log('listing_id =', b.id);"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{seller_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Téléphone Samsung Galaxy A54 test\",\n  \"description\": \"Téléphone en bon état, utilisé 6 mois. Batterie 90%.\",\n  \"price_gnf\": 4500000,\n  \"category\": \"Téléphones\",\n  \"city\": \"Conakry\",\n  \"quartier\": \"Kaloum\",\n  \"condition\": \"used\"\n}" },
            "url": { "raw": "{{base_url}}/listings/", "host": ["{{base_url}}"], "path": ["listings", ""] }
          }
        },

        {
          "name": "2.2 Lister toutes les annonces (public)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('résultats présents', () => pm.expect(b.results || b).to.be.an('array'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/listings/", "host": ["{{base_url}}"], "path": ["listings", ""] }
          }
        },

        {
          "name": "2.3 Détail annonce",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('title présent', () => pm.expect(b.title).to.be.a('string'));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/listings/{{listing_id}}/", "host": ["{{base_url}}"], "path": ["listings", "{{listing_id}}", ""] }
          }
        },

        {
          "name": "2.4 Recherche par mot-clé",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/listings/?search=Samsung", "host": ["{{base_url}}"], "path": ["listings", ""], "query": [{ "key": "search", "value": "Samsung" }] }
          }
        },

        {
          "name": "2.5 Mes annonces (vendeur)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{seller_token}}" }],
            "url": { "raw": "{{base_url}}/listings/my/", "host": ["{{base_url}}"], "path": ["listings", "my", ""] }
          }
        }

      ]
